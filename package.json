{
  "name": "cyberui-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm registry:build && pnpm --filter @cyberui/docs dev",
    "build": "pnpm registry:build && pnpm --filter @cyberui/tokens build && pnpm --filter @cyberui/react build && pnpm --filter @cyberui/docs build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"packages/{react,tokens}/src/**/*.css\" \"apps/docs/src/**/*.css\" --max-warnings 0",
    "test": "pnpm registry:check && vitest run",
    "test:e2e": "playwright test",
    "test:consumer": "node scripts/test-consumer.mjs && node scripts/test-next-consumer.mjs",
    "preview": "pnpm --filter @cyberui/docs preview",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "test:registry": "node scripts/test-registry-consumer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.10.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.32",
    "shadcn": "4.23.0",
    "stylelint": "^16.26.1",
    "tailwindcss": "4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
